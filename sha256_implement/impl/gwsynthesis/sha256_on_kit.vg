module uart_top (
  clk_d,
  sys_reset,
  RX_PIN_d,
  writeEN,
  tx_data,
  rx_rdy_Z,
  TX_PIN_d,
  rx_data_Z,
  tx_state
)
;
input clk_d;
input sys_reset;
input RX_PIN_d;
input writeEN;
input [7:0] tx_data;
output rx_rdy_Z;
output TX_PIN_d;
output [7:0] rx_data_Z;
output [1:0] tx_state;
wire VCC;
wire GND;
  uart_rx u_uart_rx (
    .clk_d(clk_d),
    .sys_reset(sys_reset),
    .RX_PIN_d(RX_PIN_d),
    .rx_rdy_Z(rx_rdy_Z),
    .rx_data_Z(rx_data_Z[7:0])
);
  uart_tx u_uart_tx (
    .clk_d(clk_d),
    .sys_reset(sys_reset),
    .writeEN(writeEN),
    .tx_data(tx_data[7:0]),
    .TX_PIN_d(TX_PIN_d),
    .tx_state(tx_state[1:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* uart_top */
